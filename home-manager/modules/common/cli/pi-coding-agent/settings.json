{
  "defaultThinkingLevel": "high",
  "defaultProjectTrust": "ask",
  "enableSkillCommands": true,
  "npmCommand": [
    "npm",
    "--ignore-scripts"
  ],
  "packages": [
    "npm:@narumitw/pi-btw@0.61.1",
    "npm:pi-hermes-memory@0.9.9",
    "npm:pi-reasonix@1.1.0",
    "npm:pi-rewind-hook@1.8.7",
    "npm:pi-web-access@0.35.0",
    "npm:pi-provider-litellm@2.3.0",
    "npm:@juicesharp/rpiv-ask-user-question@2.12.0",
    "npm:@juicesharp/rpiv-todo@2.12.0",
    "npm:pi-zentui@0.27.1",
    "npm:@narumitw/pi-plan-mode@0.58.3",
    "npm:@narumitw/pi-goal@0.54.8",
    {
      "source": "npm:pi-subagents@0.74.0",
      "extensions": []
    },
    "npm:@gotgenes/pi-permission-system@36.2.1",
    "npm:@narumitw/pi-usage@0.61.1"
  ],
  "rewind": {
    "retention": {
      "maxSnapshots": 500,
      "maxAgeDays": 30,
      "pinLabeledEntries": true
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna"
}
