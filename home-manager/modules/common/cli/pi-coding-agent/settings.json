{
  "defaultThinkingLevel": "high",
  "defaultProjectTrust": "ask",
  "enableSkillCommands": true,
  "npmCommand": [
    "npm",
    "--ignore-scripts"
  ],
  "packages": [
    "npm:@narumitw/pi-btw@0.55.1",
    "npm:pi-hermes-memory@0.9.6",
    "npm:pi-reasonix@1.1.0",
    "npm:pi-rewind-hook@1.8.5",
    "npm:pi-web-access@0.24.2",
    "npm:pi-provider-litellm@2.2.1",
    "npm:@juicesharp/rpiv-ask-user-question@2.7.1",
    "npm:@juicesharp/rpiv-todo@2.7.1",
    "npm:pi-zentui@0.20.2",
    "npm:@narumitw/pi-plan-mode@0.55.0",
    "npm:@narumitw/pi-goal@0.54.0",
    "npm:pi-subagents@0.56.0",
    "npm:@gotgenes/pi-permission-system@27.0.0",
    "npm:@narumitw/pi-usage@0.52.2"
  ],
  "rewind": {
    "retention": {
      "maxSnapshots": 500,
      "maxAgeDays": 30,
      "pinLabeledEntries": true
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna"
}
